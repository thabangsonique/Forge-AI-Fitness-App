# AI Configuration
# Set AI_ENABLED=true to enable AI features

AI_ENABLED=true

# AI Provider: "gemini" or "openrouter" (recommended for free tier)
AI_PROVIDER=openrouter

# ============================================
# OpenRouter Configuration (FREE TIER)
# ============================================
# Get your free API key at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Recommended free models (no cost per token):
# - moonshotai/kimi-k3-central (top-ranked free model)
# - deepseek/deepseek-chat (DeepSeek V3, also free)
# - google/gemini-2.0-flash (Gemini via OpenRouter)
OPENROUTER_MODEL=moonshotai/kimi-k3-central
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# OpenRouter Rate Limits (free tier)
# 20 requests/minute, 1000 requests/day
OPENROUTER_MAX_REQUESTS_PER_MINUTE=20
OPENROUTER_MAX_REQUESTS_PER_DAY=1000
OPENROUTER_MAX_INPUT_TOKENS_PER_MINUTE=60000
OPENROUTER_MAX_OUTPUT_TOKENS=1500

# ============================================
# Gemini Configuration (ALTERNATIVE)
# ============================================
# Uncomment only if using Gemini as provider:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ============================================
# Common Settings (applies to both providers)
# ============================================
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_TOKENS_PER_REQUEST=4000
AI_GLOBAL_DAILY_REQUEST_CAP=50

# Trial settings for free users
FORGE_TRIAL_DAYS=7
FORGE_TRIAL_MAX_INSIGHTS=3
FORGE_TRIAL_MAX_WORKOUT_GENERATIONS=3
FORGE_USER_COOLDOWN_SECONDS=10

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/forge_fitness

# Auth (if using Better Auth)
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3001